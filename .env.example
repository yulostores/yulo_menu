# Copy to .env for local development: cp .env.example .env
# .env is gitignored. Production values go in Vercel -> Project Settings -> Environment
# Variables. VITE_* values are inlined into the bundle at build time — never a secret here.

# Prefix for API requests. Leave blank in development to use the Vite dev proxy (see
# vite.config.js). In production point it at the backend, e.g.
# VITE_API_BASE=https://your-backend.ondigitalocean.app
VITE_API_BASE=

# Dev-only: where the Vite proxy forwards /api.
# VITE_PROXY_TARGET=http://localhost:3000

# The restaurant whose live menu the home page shows (when the site is opened without a table
# QR). Use a demo or flagship restaurant's id. Unset: the home page shows no menu section.
# VITE_FEATURED_RESTAURANT_ID=

# Where the home page's "Partner login" link points.
# VITE_RESTAURANT_PORTAL_URL=https://yulo-restaurant.vercel.app/owner/login
