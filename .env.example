# Copy to .env for local development: cp .env.example .env
# .env is gitignored. Production values go in Vercel -> Project Settings -> Environment
# Variables. VITE_* values are inlined into the bundle at build time — never a secret here.

# Prefix for API requests. Leave blank in development to use the Vite dev proxy (see
# vite.config.js). In production point it at the backend, e.g.
# VITE_API_BASE=https://your-backend.ondigitalocean.app
VITE_API_BASE=

# Dev-only: where the Vite proxy forwards /api.
# VITE_PROXY_TARGET=http://localhost:3000
